---
import { Image } from 'astro:assets';
import aboutImg from '../assets/photos/about.jpg';
import { bioFacts, career } from '../data/master';
---

<section id="about">
  <div class="wrap grid">
    <figure class="photo" data-reveal>
      <Image
        src={aboutImg}
        alt="Анна Овчинникова ведёт занятие"
        widths={[480, 720, 960]}
        sizes="(max-width: 860px) 280px, 420px"
        format="webp"
        quality={88}
        loading="lazy"
        class="photo-img"
      />
    </figure>

    <div class="copy" data-reveal data-reveal-delay="140">
      <span class="section-eyebrow">Обо мне</span>
      <h2>
        Психолог, преподаватель и&nbsp;руководитель центра <em>«Метафора».</em>
      </h2>

      <p class="lead">
        Больше 15&nbsp;лет работаю с&nbsp;клиентами и&nbsp;обучаю специалистов.
        Преподаю в&nbsp;РАНХиГС, веду программы по&nbsp;песочной
        и&nbsp;телесно-ориентированной терапии, НЛП.
      </p>

      <p>
        Как бизнес-психолог помогаю увидеть, <strong>что мешает зарабатывать</strong>,
        и&nbsp;попробовать действовать иначе. А&nbsp;в&nbsp;работе с&nbsp;песком
        рассказываю, как через работу с&nbsp;бессознательным понимать, что
        и&nbsp;почему происходит, и&nbsp;бережно менять свою жизнь.
      </p>

      <dl class="facts">
        {bioFacts.map((f) => (
          <div>
            <dt>{f.value}</dt>
            <dd>{f.label}</dd>
          </div>
        ))}
      </dl>

      <ul class="career">
        {career.map((c) => (
          <li><span class="yr">{c.years}</span><span>{c.text}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .photo {
    margin: 0;
  }
  .photo-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    display: block;
  }
  h2 {
    margin-bottom: 28px;
  }
  h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .lead {
    font-size: 18px;
    color: var(--ink);
    margin-bottom: 18px;
    line-height: 1.6;
  }
  .copy p {
    color: var(--ink-muted);
    margin-bottom: 18px;
    font-size: 17px;
    line-height: 1.65;
  }
  .copy p strong {
    color: var(--ink);
    font-weight: 500;
  }


  .facts {
    margin: 36px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .facts div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .facts dt {
    font-family: var(--font-serif);
    font-size: 26px;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.05;
  }
  .facts dd {
    margin: 0;
    font-size: 13px;
    color: var(--ink-muted);
  }

  .career {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    gap: 10px;
  }
  .career li {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 16px;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .yr {
    color: var(--accent);
    font-family: var(--font-serif);
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .photo {
      max-width: 280px;
    }
    .facts {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
