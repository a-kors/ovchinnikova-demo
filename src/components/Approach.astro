---
import { method, story } from '../data/master';
---

<section id="method" class="approach">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Метод</span>
      <h2>
        Почему песочная терапия даёт <em>быстрые результаты.</em>
      </h2>
      <p>
        Это не&nbsp;про «просто поиграть в&nbsp;песок». Это про внутренние
        процессы, которые сложно выразить словами, но&nbsp;можно прожить
        и&nbsp;осознать через действие.
      </p>
    </header>

    <div class="principles">
      {method.points.map((p, i) => (
        <article class="pr" data-reveal data-reveal-delay={Math.min(i * 100, 300)}>
          <span class="n">0{i + 1}</span>
          <h3 set:html={p.title} />
          <p>{p.text}</p>
        </article>
      ))}
    </div>

    <p class="note" data-reveal set:html={method.note} />

    <figure class="quote" data-reveal>
      <span class="mark" aria-hidden="true">“</span>
      <blockquote>
        <strong>{story.quote}</strong> {story.text}
      </blockquote>
      <figcaption>Из&nbsp;практики</figcaption>
    </figure>
  </div>
</section>

<style>
  .approach {
    background: var(--bg-soft);
  }
  .section-head {
    max-width: 760px;
    margin-bottom: 48px;
  }
  .section-head h2 em {
    font-style: italic;
    color: var(--accent);
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 72px;
  }
  .pr {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 24px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .n {
    font-family: var(--font-serif);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .pr h3 {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
    font-weight: 400;
  }
  .pr p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .note {
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(19px, 2vw, 22px);
    color: var(--accent);
    margin: -32px auto 72px;
    max-width: 760px;
  }
  blockquote strong {
    font-weight: 400;
    color: var(--accent);
    font-style: italic;
  }
  .quote {
    margin: 0 auto;
    max-width: 920px;
    text-align: left;
    position: relative;
    padding-left: 48px;
  }
  .mark {
    position: absolute;
    left: -8px;
    top: -36px;
    font-family: var(--font-serif);
    font-size: 180px;
    color: var(--accent);
    line-height: 1;
    opacity: 0.15;
    user-select: none;
  }
  blockquote {
    margin: 0 0 24px;
    font-family: var(--font-serif);
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.4;
    color: var(--ink);
    letter-spacing: -0.015em;
  }
  figcaption {
    font-size: 14px;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  @media (max-width: 1024px) {
    .principles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .principles {
      grid-template-columns: 1fr;
    }
    .quote {
      padding-left: 28px;
    }
    .mark {
      left: -4px;
      top: -20px;
      font-size: 120px;
    }
  }
</style>
